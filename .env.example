# ==============================================================================
# GenAI Event Planner - Environment Configuration (100% Free Tier)
# ==============================================================================

# Groq API Key (100% Free - No credit card required)
# 1. Sign up / Log in at https://console.groq.com
# 2. Navigate to "API Keys" -> Create New API Key (e.g. gsk_...)
# 3. Paste the key below:
GROQ_API_KEY=gsk_your_free_groq_api_key_here

# Groq Model Name (Configurable free models):
# - openai/gpt-oss-120b       (Recommended: Strongest free reasoning model, 120B parameters)
# - qwen/qwen3.8-27b          (Fast, high-quality multilingual model)
# - openai/gpt-oss-20b        (Ultra low-latency alternative)
GROQ_MODEL=openai/gpt-oss-120b

# Server Bindings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# State Storage Directory (Relative or absolute path)
STATE_DIR=state

# CORS Allowed Origins (Comma-separated or JSON list for frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
